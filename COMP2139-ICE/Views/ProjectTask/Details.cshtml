@model COMP2139_ICE.Models.ProjectTask

@{
    ViewData["Title"] = "Task Details";
}

<h2>Task Details</h2>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Title</dt>
        <dd class="col-sm-9">@Model.Title</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Model.Description</dd>

        <dt class="col-sm-3">Project ID</dt>
        <dd class="col-sm-9">@Model.ProjectId</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.ProjectTaskId" class="btn btn-warning">Edit</a> |
    <a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="btn btn-secondary">Back to List</a>
</div>